---
import Layout from "../../layouts/Layout.astro";
import BookCard from "../../components/BookCard.astro";
import { slugify } from "../../lib/slug";
import { getBooks, tagCounts, type Book } from "../../lib/books";

export async function getStaticPaths() {
  const books = await getBooks();
  return tagCounts(books).map(({ tag }) => ({
    params: { tag: slugify(tag) },
    props: { tag, books: books.filter((b) => b.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  books: Book[];
}

const { tag, books } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Layout title={`${tag} — Bokblogg`} description={`Bokanmeldelser om ${tag.toLowerCase()} på Bokblogg.`}>
  <nav class="crumbs" aria-label="Brødsmuler">
    <a href={base}>Alle bøkene</a> <span aria-hidden="true">/</span> <a href={`${base}tag/`}>Temaer</a>
  </nav>
  <h1 class="page-title">{tag}</h1>
  <p class="page-lead">{books.length} {books.length === 1 ? "bok" : "bøker"} om dette temaet.</p>
  <ul class="shelf-grid">
    {books.map((book) => <BookCard book={book} />)}
  </ul>
</Layout>
