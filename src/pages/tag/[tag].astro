---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { slugify } from "../../lib/slug";

export async function getStaticPaths() {
  const books = await getCollection("books");
  const tags = [...new Set(books.flatMap((b) => b.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, books: books.filter((b) => b.data.tags.includes(tag)) },
  }));
}

const { tag, books } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Layout title={`${tag} — Bokblogg`} description={`Bøker merket "${tag}" på Bokblogg.`}>
  <a class="back-link" href={base}>&larr; Alle bøker</a>
  <h1>Tag: {tag}</h1>
  <ul class="book-grid">
    {books.map((book) => (
      <li class="book-card">
        <a class="cover-link" href={`${base}bok/${book.id}/`}>
          {book.data.coverUrl ? (
            <img class="cover" src={book.data.coverUrl} alt={`Omslag: ${book.data.title}`} loading="lazy" />
          ) : (
            <div class="cover-placeholder" aria-hidden="true">{book.data.title[0]}</div>
          )}
        </a>
        <h2><a href={`${base}bok/${book.id}/`}>{book.data.title}</a></h2>
        <p class="meta">
          {book.data.author ?? "Ukjent forfatter"}
          {book.data.rating !== null && <> · {book.data.rating}/10</>}
        </p>
      </li>
    ))}
  </ul>
</Layout>
