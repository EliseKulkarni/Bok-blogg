---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { slugify } from "../lib/slug";

const books = (await getCollection("books")).sort(
  (a, b) => b.data.dateAdded.valueOf() - a.data.dateAdded.valueOf()
);

const base = import.meta.env.BASE_URL;

const dateFormatter = new Intl.DateTimeFormat("no-NO", { day: "numeric", month: "short", year: "numeric" });

const ratedBooks = books.filter((b) => b.data.rating !== null);
const avgRating = ratedBooks.length
  ? (ratedBooks.reduce((sum, b) => sum + (b.data.rating ?? 0), 0) / ratedBooks.length).toFixed(1)
  : null;
---
<Layout title="Bokblogg — bokanmeldelser">
  <section class="intro">
    <img class="avatar" src={`${base}BildeLinkedIn.jpg`} alt="Elise" />
    <div>
      <h2>Hei, jeg er Elise 👋</h2>
      <p>
        Jeg er student og leser mye — mest sakprosa om læring, vaner og det å
        forstå seg selv litt bedre. Her samler jeg korte, ærlige anmeldelser av
        bøkene jeg leser, automatisk hentet fra notatene mine i Notion.
      </p>
      <p class="ps">(PS: de første anmeldelsene er skrevet litt raskt og delvis AI-oppsummert. Blir bedre etter hvert!)</p>
      <p class="stats">
        📚 {books.length} {books.length === 1 ? "bok anmeldt" : "bøker anmeldt"}
        {avgRating && <> · ⭐ snitt {avgRating}/10</>}
      </p>
    </div>
  </section>

  <div class="toolbar">
    <div class="search-field">
      <svg class="search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.5" />
        <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        id="book-search"
        placeholder="Søk på tittel, forfatter eller tag …"
        aria-label="Søk i bøker"
      />
    </div>
    <div class="sort-group" role="group" aria-label="Sorter bøker">
      <button type="button" class="sort-btn is-active" data-sort="date">Nyeste</button>
      <button type="button" class="sort-btn" data-sort="rating">Høyest rating</button>
    </div>
  </div>

  <p id="empty-state" class="empty-state" hidden>Fant ingen bøker som matcher søket.</p>

  <ul class="book-grid" id="book-grid">
    {books.map((book) => (
      <li
        class="book-card"
        data-title={book.data.title.toLowerCase()}
        data-author={(book.data.author ?? "").toLowerCase()}
        data-tags={book.data.tags.join(", ").toLowerCase()}
        data-rating={book.data.rating ?? -1}
        data-date={book.data.dateAdded.valueOf()}
      >
        <a class="cover-link" href={`${base}bok/${book.id}/`}>
          {book.data.coverUrl ? (
            <img class="cover" src={book.data.coverUrl} alt={`Omslag: ${book.data.title}`} loading="lazy" />
          ) : (
            <div class="cover-placeholder" aria-hidden="true">{book.data.title[0]}</div>
          )}
        </a>
        <h2><a href={`${base}bok/${book.id}/`}>{book.data.title}</a></h2>
        <p class="meta">
          <span>{book.data.author ?? "Ukjent forfatter"}</span>
          {book.data.rating !== null && <span class="rating-badge">★ {book.data.rating}/10</span>}
        </p>
        {book.data.essensen && <p class="essensen">{book.data.essensen}</p>}
        <p class="upload-date">{dateFormatter.format(book.data.dateAdded)}</p>
        {book.data.tags.length > 0 && (
          <div class="tags">
            {book.data.tags.map((tag) => (
              <a class="tag" href={`${base}tag/${slugify(tag)}/`}>{tag}</a>
            ))}
          </div>
        )}
      </li>
    ))}
  </ul>
</Layout>

<script>
  const grid = document.getElementById("book-grid");
  const cards = Array.from(document.querySelectorAll(".book-card"));
  const searchInput = document.getElementById("book-search");
  const sortButtons = document.querySelectorAll(".sort-btn");
  const emptyState = document.getElementById("empty-state");

  let sortBy = "date";

  function applyFilterAndSort() {
    const query = (searchInput?.value ?? "").trim().toLowerCase();

    const sorted = [...cards].sort((a, b) => {
      const key = sortBy === "rating" ? "rating" : "date";
      return Number(b.dataset[key]) - Number(a.dataset[key]);
    });
    sorted.forEach((card) => grid?.appendChild(card));

    let visibleCount = 0;
    for (const card of cards) {
      const haystack = `${card.dataset.title} ${card.dataset.author} ${card.dataset.tags}`;
      const matches = query === "" || haystack.includes(query);
      card.hidden = !matches;
      if (matches) visibleCount++;
    }

    if (emptyState) emptyState.hidden = visibleCount !== 0;
  }

  searchInput?.addEventListener("input", applyFilterAndSort);

  sortButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      sortBy = btn.getAttribute("data-sort") ?? "date";
      sortButtons.forEach((b) => b.classList.toggle("is-active", b === btn));
      applyFilterAndSort();
    });
  });
</script>
