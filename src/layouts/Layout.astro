---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  narrow?: boolean;
  /** "article" for enkeltanmeldelser, ellers "website". */
  type?: "website" | "article";
  publishedTime?: string;
  /** Ekstra JSON-LD for siden (f.eks. en Review på boksidene). */
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = "Bokblogg av Elise Kulkarni – korte, ærlige anmeldelser av bøker om læring, vaner og selvinnsikt.",
  image,
  narrow = false,
  type = "website",
  publishedTime,
  structuredData: pageData,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = new URL(base, Astro.site).href;
// Delingsbilde: egen pr. bok (se src/pages/og/), ellers et felles for bloggen.
const shareImage = image ?? new URL(`${base}og-image.png`, Astro.site).href;
const isHome = Astro.url.pathname === base || Astro.url.pathname === base.replace(/\/$/, "");
const path = Astro.url.pathname;

// Usynlig for leseren, men forteller søkemotorer hvem som står bak bloggen.
const blogData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Bokblogg",
  url: siteURL,
  inLanguage: "no",
  author: { "@type": "Person", name: "Elise Kulkarni", url: siteURL },
};
---
<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Elise sin bokblogg" href={new URL(`${base}rss.xml`, Astro.site).href} />
    <meta name="theme-color" content="#f7f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141513" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Bokblogg" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <meta name="author" content="Elise Kulkarni" />
    <script type="application/ld+json" set:html={JSON.stringify(blogData)} />
    {pageData && <script type="application/ld+json" set:html={JSON.stringify(pageData)} />}
  </head>
  <body>
    <a class="skip-link" href="#innhold">Hopp til innhold</a>
    <header class="site">
      {isHome ? (
        <h1 class="site-title"><a href={base}>Bokblogg</a></h1>
      ) : (
        <p class="site-title"><a href={base}>Bokblogg</a></p>
      )}
      <nav class="site-nav" aria-label="Hovedmeny">
        <a href={base} aria-current={isHome ? "page" : undefined}>Bøker</a>
        <a href={`${base}tag/`} aria-current={path.startsWith(`${base}tag/`) ? "page" : undefined}>Temaer</a>
        <a href={`${base}om/`} aria-current={path.startsWith(`${base}om`) ? "page" : undefined}>Om</a>
        <a href={`${base}rss.xml`} title="Følg via RSS">RSS</a>
      </nav>
    </header>
    <main id="innhold" class:list={{ narrow }}>
      <slot />
    </main>
    <footer class="site">
      <div class="footer-inner">
        <div class="follow">
          <p class="follow-title">Få beskjed om nye bøker</p>
          <p>
            Lim inn <a href={`${base}rss.xml`}>RSS-adressen</a> i en RSS-leser
            (f.eks. Feedly, NetNewsWire eller Thunderbird), så dukker nye
            anmeldelser opp der automatisk.
          </p>
        </div>
        <p class="byline">Skrevet av Elise Kulkarni</p>
      </div>
    </footer>
  </body>
</html>
