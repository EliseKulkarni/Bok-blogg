---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <h1><a href={import.meta.env.BASE_URL}>📚 Bokblogg</a></h1>
      <p>Bokanmeldelser, automatisk hentet fra Notion.</p>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
