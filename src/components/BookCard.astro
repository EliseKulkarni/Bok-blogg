---
import { displayTitle, type Book } from "../lib/books";

interface Props {
  book: Book;
}

// Én bok i hylla: omslaget er bildet, teksten under er tittel, bok/forfatter og karakter.
const { book } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}bok/${book.id}/`;
const { title, headline, author, rating, coverUrl, essensen, tags, status, dateAdded } = book.data;
---
<li
  class="shelf-item"
  data-title={`${headline ?? ""} ${title}`.toLowerCase()}
  data-author={(author ?? "").toLowerCase()}
  data-tags={tags.join("|").toLowerCase()}
  data-text={(essensen ?? "").toLowerCase()}
  data-rating={rating ?? -1}
  data-date={dateAdded.valueOf()}
>
  <a class="shelf-link" href={href}>
    <span class="shelf-cover">
      {coverUrl ? (
        <img src={coverUrl} alt="" loading="lazy" decoding="async" width="200" height="300" />
      ) : (
        <span class="cover-blank" aria-hidden="true">{title}</span>
      )}
    </span>
    <h3 class="shelf-title">{displayTitle(book)}</h3>
  </a>
  <p class="shelf-meta">
    <span class="shelf-book">{headline && <span class="sr-only">{title} av </span>}{author ?? "ukjent forfatter"}</span>
    {rating !== null && <span class="shelf-rating">{rating}<span class="of">/10</span></span>}
  </p>
  {status === "80%" && <p class="shelf-status">Nesten ferdig lest</p>}
</li>
